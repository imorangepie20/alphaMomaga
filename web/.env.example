# Preferred server-side API origin
API_URL=https://api.approid.team

# Optional compatibility fallback for deployments that expose only public variables
NEXT_PUBLIC_API_URL=https://api.approid.team

# Auth0 server session configuration. Never expose these with NEXT_PUBLIC_ prefixes.
APP_BASE_URL=http://localhost:3001
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET
AUTH0_AUDIENCE=https://api.approid.team/
# Generate with: openssl rand -hex 32
AUTH0_SECRET=YOUR_64_CHARACTER_HEX_SECRET
