# Auth0 signed JWT verification configuration
AUTH_JWKS_URL=https://YOUR_AUTH0_DOMAIN/.well-known/jwks.json
AUTH_ISSUER=https://YOUR_AUTH0_DOMAIN/
AUTH_AUDIENCE=YOUR_AUTH0_API_IDENTIFIER

# Local-only compatibility fallback; keep false in shared environments
AUTH_ALLOW_DEMO_ROLE=false

# PostgreSQL persistence
DATABASE_URL=postgresql://localhost/property_manager

# Dedicated Auth0 M2M application; never reuse browser-visible credentials
AUTH0_MANAGEMENT_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Database connection and existing regular web app ID for invitation tickets
AUTH0_MANAGEMENT_CONNECTION=Username-Password-Authentication
AUTH0_INVITATION_CLIENT_ID=
