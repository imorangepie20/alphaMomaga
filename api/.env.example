# Auth0 signed JWT verification configuration
AUTH_JWKS_URL=https://YOUR_AUTH0_DOMAIN.auth0.com/.well-known/jwks.json
AUTH_ISSUER=https://YOUR_AUTH0_DOMAIN.auth0.com/
AUTH_AUDIENCE=YOUR_AUTH0_API_IDENTIFIER

# Local-only compatibility fallback; keep false in shared environments
AUTH_ALLOW_DEMO_ROLE=false

# PostgreSQL persistence
DATABASE_URL=postgresql://localhost/property_manager
